rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.uid == 'vJCq3yQDe0QcCg5EoEPnjVKwUgJ2'; }
    function deliveryBoy() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'Rakeshsaini1@gmail.com','rakeshsaini1@gmail.com',
          'Rakeshsaini2@gmail.com','rakeshsaini2@gmail.com',
          'Rakeshsaini3@gmail.com','rakeshsaini3@gmail.com',
          'Rakeshsaini4@gmail.com','rakeshsaini4@gmail.com',
          'Rakeshsaini5@gmail.com','rakeshsaini5@gmail.com'
        ];
    }
    function couponValid() {
      return request.resource.data.couponCode == ''
        ? request.resource.data.discount == 0
        : exists(/databases/$(database)/documents/coupons/$(request.resource.data.couponCode))
          && get(/databases/$(database)/documents/coupons/$(request.resource.data.couponCode)).data.enabled == true
          && get(/databases/$(database)/documents/coupons/$(request.resource.data.couponCode)).data.firstOnly == false
          && request.resource.data.subtotal >= get(/databases/$(database)/documents/coupons/$(request.resource.data.couponCode)).data.minOrder
          && ((get(/databases/$(database)/documents/coupons/$(request.resource.data.couponCode)).data.type == 'PERCENT' && request.resource.data.discount == (request.resource.data.subtotal * get(/databases/$(database)/documents/coupons/$(request.resource.data.couponCode)).data.value / 100 <= request.resource.data.subtotal ? request.resource.data.subtotal * get(/databases/$(database)/documents/coupons/$(request.resource.data.couponCode)).data.value / 100 : request.resource.data.subtotal)) || (get(/databases/$(database)/documents/coupons/$(request.resource.data.couponCode)).data.type == 'FLAT' && request.resource.data.discount == (get(/databases/$(database)/documents/coupons/$(request.resource.data.couponCode)).data.value <= request.resource.data.subtotal ? get(/databases/$(database)/documents/coupons/$(request.resource.data.couponCode)).data.value : request.resource.data.subtotal)));
    }
    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.paymentMethod == 'COD' && request.resource.data.subtotal >= 100 && request.resource.data.deliveryFee == 30 && request.resource.data.discount >= 0 && request.resource.data.discount <= request.resource.data.subtotal && request.resource.data.total == request.resource.data.subtotal + 30 - request.resource.data.discount && couponValid() && request.resource.data.status == 'PLACED';
      allow get, list: if signedIn() && (resource.data.userId == request.auth.uid || admin() || (deliveryBoy() && resource.data.deliveryBoyEmail == request.auth.token.email));
      allow update: if signedIn() && (
        (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'CANCELLED')
        || admin()
        || (deliveryBoy() && resource.data.deliveryBoyEmail == request.auth.token.email && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && (request.resource.data.status == 'OUT_FOR_DELIVERY' || request.resource.data.status == 'DELIVERED'))
      );
      allow delete: if admin();
    }
    match /deliveryBoys/{uid} {
      allow read: if signedIn() && (admin() || request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.latitude is number && request.resource.data.longitude is number;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','latitude','longitude','accuracyMeters','lastSeenAt','online']);
      allow delete: if admin();
    }
    match /users/{uid} { allow read, write: if signedIn() && request.auth.uid == uid; match /addresses/{addressId} { allow read, create, update, delete: if signedIn() && request.auth.uid == uid; } }
    match /reviews/{reviewId} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId)) && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == 'DELIVERED' && request.resource.data.rating >= 1 && request.resource.data.rating <= 5; allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin()); allow update, delete: if false; }
    match /admins/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /menu/{itemId} { allow read: if true; allow write: if admin(); }
    match /offers/{offerId} { allow read: if true; allow write: if admin(); }
    match /coupons/{couponId} { allow read: if true; allow write: if admin(); }
    match /{document=**} { allow read, write: if false; }
  }
}